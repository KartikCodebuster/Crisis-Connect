rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kartikgkp12@gmail.com';
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
               data.uid == userId &&
               data.uid == request.auth.uid &&
               data.email is string &&
               data.updatedAt == request.time;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin()); // Only list yourself or use targeted get
      
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && 
                       isValidUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber', 'lastLocation', 'geohash', 'updatedAt']);

      // memberships are private to the user
      match /memberships/{circleId} {
        allow read: if isSignedIn() && userId == request.auth.uid;
        allow write: if isSignedIn() && userId == request.auth.uid;
      }
    }

    // --- Emergencies ---
    // ...
    match /emergencies/{emergencyId} {
      function isValidEmergencyCreate(data) {
        return data.keys().hasAll(['requesterId', 'location', 'geohash', 'status', 'createdAt', 'updatedAt']) &&
               data.requesterId == request.auth.uid &&
               data.status == 'pending' &&
               data.location.lat is number && data.location.lng is number &&
               data.geohash is string && data.geohash.size() <= 50 &&
               data.createdAt == request.time &&
               data.updatedAt == request.time;
      }

      // Proximity dashboard needs to list all pending/active emergencies
      allow list: if isSignedIn() || isAdmin(); 
      allow get: if isSignedIn() || isAdmin(); 

      allow create: if isSignedIn() && isValidEmergencyCreate(incoming()) && 
                       isValidId(emergencyId);

      allow update: if isSignedIn() && (
        // Action: Accept Help (Helper joins)
        (existing().status == 'pending' && 
         incoming().status == 'accepted' && 
         incoming().helperId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'helperId', 'helperName', 'updatedAt']) &&
         incoming().updatedAt == request.time) ||
        
        // Action: Resolve (by requester or helper)
        (existing().status == 'accepted' && 
         incoming().status == 'resolved' && 
         (request.auth.uid == existing().requesterId || request.auth.uid == existing().helperId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().updatedAt == request.time) ||

        // Action: Cancel (by requester)
        (existing().status == 'pending' && 
         incoming().status == 'resolved' && 
         request.auth.uid == existing().requesterId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().updatedAt == request.time)
      );

      allow delete: if false; 

      // --- Messages ---
      match /messages/{messageId} {
        function canChat() {
          let emg = get(/databases/$(database)/documents/emergencies/$(emergencyId)).data;
          return request.auth.uid == emg.requesterId || request.auth.uid == emg.helperId;
        }
        
        allow list, get: if isSignedIn() && canChat();
        allow create: if isSignedIn() && canChat() && 
                         incoming().senderId == request.auth.uid &&
                         incoming().text is string && 
                         incoming().text.size() <= 1000 &&
                         incoming().createdAt == request.time;
      }
    }

    // --- Circles ---
    match /circles/{circleId} {
      function isCircleOwner() {
        return isSignedIn() && existing().ownerId == request.auth.uid;
      }

      function isCircleMember() {
        return isSignedIn() && exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
      }

      function isValidCircle(data) {
        return data.keys().hasAll(['name', 'ownerId', 'inviteCode', 'createdAt']) &&
               data.ownerId == request.auth.uid &&
               data.name is string && data.name.size() <= 100 &&
               data.inviteCode is string && data.inviteCode.size() == 6 &&
               data.createdAt == request.time;
      }

      allow get: if isSignedIn() || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      
      allow create: if isSignedIn() && isValidCircle(incoming());
      allow update: if isCircleOwner() && 
                       incoming().ownerId == existing().ownerId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name']);

      match /members/{memberId} {
        allow list, get: if isSignedIn() && (isCircleOwner() || isCircleMember());
        allow create: if isSignedIn() && memberId == request.auth.uid && 
                         exists(/databases/$(database)/documents/circles/$(circleId));
        allow delete: if isCircleOwner() || (isSignedIn() && memberId == request.auth.uid);
      }
    }

    // --- Invite Codes ---
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && 
                       incoming().circleId is string &&
                       exists(/databases/$(database)/documents/circles/$(incoming().circleId)) &&
                       get(/databases/$(database)/documents/circles/$(incoming().circleId)).data.ownerId == request.auth.uid;
    }
  }
}
